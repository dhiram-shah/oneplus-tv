<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar focus: a white ring outside the coloured circle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><stroke android:width="2dp" android:color="#FFF5F6F8" /></shape>
    </item>
    <item><shape android:shape="oval"><solid android:color="#00000000" /></shape></item>
</selector>
